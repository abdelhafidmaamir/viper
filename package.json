{
  "name": "viper",
  "productName": "Viper",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive TikTok LIVE snake games (Duel, Feed the Snake): a capturable game window driven by a private control room.",
  "author": "Abdel Maamir",
  "license": "UNLICENSED",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.build.json",
    "build:renderer": "vite build",
    "dev": "npm run build:main && node scripts/dev.ts",
    "start": "npm run build && electron .",
    "start:landscape": "npm run build && electron . --orientation=landscape",
    "diagnose": "npm run build && electron . --diagnostic",
    "visual": "npm run build && node scripts/visual.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/renderer/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "package": "npm run build && node scripts/package.ts",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml,css}": "prettier --write"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^5.0.2",
    "electron": "^44.4.5",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "lint-staged": "^17.6.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "simple-git-hooks@2.14.0": true,
    "electron@44.4.5": true
  },
  "type": "module"
}
